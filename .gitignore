## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This file is a combination of the VisualStudio and Windows gitignore templates
## from https://github.com/github/gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Xx][Oo][Bb][Jj]
[Ww][Ii][Xx][Pp][Dd][Bb]
arm/
arm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build log of MSBuild
*.log

# Visual Studio analyzer warnings
*.codeanalysis_results.xml

# Diagnostic database files
*.cdxml
*.pdb
*.aps

# Output files
*.msi
*.msix
*.msxm
*.msm
*.msp

# Others
.DS_Store
Thumbs.db
desktop.ini
publish/
*.bak
*.tmp
*.temp
