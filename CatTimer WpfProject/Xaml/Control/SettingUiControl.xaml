<UserControl x:Class="CatTimer_WpfProject.SettingUiControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatTimer_WpfProject"
             mc:Ignorable="d" 
             d:DesignHeight="344" d:DesignWidth="394"
             Name="SettingUiUserControl"
             IsVisibleChanged="SettingUiControl_OnIsVisibleChanged">


    <!--设置界面-->
    <Canvas>

        <!--关闭按钮：点击后，关闭此窗口-->
        <local:ButtonControl x:Name="CloseButtonControl"
                             ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                             Width="300" Height="340"
                             Background="Transparent"></local:ButtonControl>


        <!--波点1-->
        <Border Width="220" Height="276" Canvas.Left="10" Canvas.Top="6"
                Background="{StaticResource Other.WavePoint.ImageBrush}"
                IsHitTestVisible="False"></Border>

        <!--这是一个很大的Button：点击这个Button，可以关闭界面-->
        <Button Name="CloseButton"
                Height="340" Width="300" 
                Style="{StaticResource NoBackgroundButtonStyle}"
                Click="CloseButton_OnClick"
                PreviewMouseDown="CloseButton_OnPreviewMouseDown"
                PreviewMouseUp="CloseButton_OnPreviewMouseUp"></Button>

        <!--背景-->
        <Border Width="200" Height="260" Canvas.Left="50" Canvas.Top="35"
                            Background="White" CornerRadius="12"
                            Opacity="1">
            <Border.Effect>
                <DropShadowEffect Direction="0" ShadowDepth="0" BlurRadius="20" 
                                              Opacity="0.22" Color="#FF7A7A7A"></DropShadowEffect>
            </Border.Effect>

            <Border Width="16" Height="11" Margin="140,-275,0,0"
                    Background="{StaticResource Icon.WhiteArrow.ImageBrush}"></Border>
        </Border>
        <!--波点2-->
        <Border Width="190" Height="250" Canvas.Left="55" Canvas.Top="40"
                Background="{StaticResource Other.WavePoint.ImageBrush}" 
                IsHitTestVisible="False"></Border>

        <!--下半部分的内容-->
        <Canvas Width="200" Height="260" Canvas.Left="50" Canvas.Top="35">
            <!--文字部分-->
            <Border Name="TitleBorder"
                    Width="60" Height="50"
                    Background="{DynamicResource Setting.Title.ImageBrush}" Canvas.Left="15" Canvas.Top="15"></Border>


            <!--声音-->
            <Slider Name="VolumeSlider"
                    Style="{DynamicResource CuteSliderStyle}" 
                    Width="100" Height="20" Canvas.Left="85" Canvas.Top="20"
                    Minimum="0" Maximum="100" Value="{Binding SettingData.Volume}"
                    Orientation="Horizontal" LargeChange="20" SmallChange="20"
                    TickFrequency="20" IsSnapToTickEnabled="True"
                    MouseEnter="VolumeSlider_OnMouseEnter"
                    MouseLeave="VolumeSlider_OnMouseLeave"
                    ValueChanged="VolumeSlider_OnValueChanged"></Slider>

            <!--语言-->
            <local:ToggleControl x:Name="LanguageToggleControl"
                                 Width="70" Height="24" Canvas.Left="105" Canvas.Top="45"
                                 Icon="{StaticResource Setting.Chinese.ImageBrush}"
                                 IconWidth="62" IconHeight="21"></local:ToggleControl>

            <!--置顶-->
            <TextBlock Text="{DynamicResource Setting.Topmost.Text}" 
                       FontSize="16" Foreground="#FF656565"
                       Canvas.Left="20" Canvas.Top="80" />
            <local:CheckBoxControl x:Name="TopmostCheckBox"
                                   Width="16" Height="16" Canvas.Left="140" Canvas.Top="82"
                                   Background="{StaticResource CheckBox.Background.ImageBrush}"
                                   Icon="{StaticResource CheckBox.Foreground.ImageBrush}"
                                   IconWidth="10" IconHeight="10"
                                   Cursor="Hand"
                                   IsChecked="{Binding SettingData.IsTopmost, Mode=TwoWay}" />

            <!--番茄钟开启-->
            <TextBlock Text="{DynamicResource Setting.Pomodoro.Text}" 
                       FontSize="16" Foreground="#FF656565"
                       Canvas.Left="20" Canvas.Top="110" />
            <local:CheckBoxControl x:Name="PomodoroEnabledCheckBox"
                                   Width="16" Height="16" Canvas.Left="140" Canvas.Top="112"
                                   Background="{StaticResource CheckBox.Background.ImageBrush}"
                                   Icon="{StaticResource CheckBox.Foreground.ImageBrush}"
                                   IconWidth="10" IconHeight="10"
                                   Cursor="Hand"
                                   IsChecked="{Binding SettingData.IsPomodoroEnabled, Mode=TwoWay}" />

            <!--番茄钟配置 (仅开启时显示)-->
            <StackPanel Canvas.Left="20" Canvas.Top="140" Width="160"
                        Visibility="{Binding SettingData.IsPomodoroEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                
                <!--工作时间-->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{DynamicResource Setting.Pomodoro.Work}" FontSize="12" Foreground="#FF656565" Width="45"
                               VerticalAlignment="Center"/>
                    <Slider Width="70" Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding SettingData.PomodoroWorkTime}" Style="{DynamicResource CuteSliderStyle}"/>
                    <TextBlock Text="{Binding SettingData.PomodoroWorkTime}" FontSize="12" Foreground="#FF656565" Margin="3,0"
                               FontFamily="{StaticResource MaybeCuteFontFamily}" VerticalAlignment="Center"/>
                </StackPanel>

                <!--休息时间-->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{DynamicResource Setting.Pomodoro.Rest}" FontSize="12" Foreground="#FF656565" Width="45"
                               VerticalAlignment="Center"/>
                    <Slider Width="70" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SettingData.PomodoroRestTime}" Style="{DynamicResource CuteSliderStyle}"/>
                    <TextBlock Text="{Binding SettingData.PomodoroRestTime}" FontSize="12" Foreground="#FF656565" Margin="3,0"
                               FontFamily="{StaticResource MaybeCuteFontFamily}" VerticalAlignment="Center"/>
                </StackPanel>

                <!--循环次数-->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{DynamicResource Setting.Pomodoro.Cycle}" FontSize="12" Foreground="#FF656565" Width="45"
                               VerticalAlignment="Center"/>
                    <Slider Width="70" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SettingData.PomodoroCycleCount}" Style="{DynamicResource CuteSliderStyle}"/>
                    <TextBlock Text="{Binding SettingData.PomodoroCycleCount}" FontSize="12" Foreground="#FF656565" Margin="3,0"
                               FontFamily="{StaticResource MaybeCuteFontFamily}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Grid Name="LanguageGrid"
                  Visibility="{Binding ElementName=LanguageToggleControl,Path=IsChecked,Converter={StaticResource BooleanToVisibilityConverter}}"
                  Width="90" Height="60" Canvas.Left="100" Canvas.Top="-10">
                <Border Background="#FFFFCA00" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect Direction="0" ShadowDepth="0" BlurRadius="15" 
                                          Opacity="0.15" Color="#FF7A7A7A"/>
                    </Border.Effect>
                </Border>
                <StackPanel Width="105" Height="74">
                    <local:ButtonControl x:Name="ChineseButtonControl"
                                         ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                         Margin="5,5,5,2" Width="80" Height="28"
                                         Icon="{StaticResource Setting.Chinese.ImageBrush}"
                                         IconWidth="71" IconHeight="24"
                                         Cursor="Hand"
                                         Click="ChineseButtonControl_OnClick"></local:ButtonControl>
                    <local:ButtonControl x:Name="EnglishButtonControl"
                                         ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                         Margin="5,2,5,5" Width="80" Height="28"
                                         Icon="{StaticResource Setting.English.ImageBrush}"
                                         IconWidth="71" IconHeight="24"
                                         Cursor="Hand"
                                         Click="EnglishButtonControl_OnClick"></local:ButtonControl>
                </StackPanel>
            </Grid>

        </Canvas>



        <!--音量大小-->
        <Popup Name="VolumePopup"
               PlacementTarget="{Binding ElementName=VolumeSlider}" Placement="Right"
               Width="50" Height="27" HorizontalOffset="0" VerticalOffset="-3.5"
               IsHitTestVisible="False" AllowsTransparency="True"
               PopupAnimation="Fade">
            <!--音量大小-->
            <Border IsHitTestVisible="False" Opacity="1"
                    Background="DimGray"  CornerRadius="5">
                <TextBlock Name="VolumeTextBlock" FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"
                           Text="{Binding SettingData.Volume}" FontSize="20" Foreground="Gold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"></TextBlock>
                <Border.Effect>
                    <DropShadowEffect Direction="0" ShadowDepth="0" BlurRadius="10" 
                                      Opacity="0.2" Color="#FF7A7A7A"></DropShadowEffect>
                </Border.Effect>
            </Border>
        </Popup>

    </Canvas>

</UserControl>
