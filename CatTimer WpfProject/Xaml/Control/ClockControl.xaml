<UserControl x:Class="CatTimer_WpfProject.ClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatTimer_WpfProject"
             mc:Ignorable="d" 
             d:DesignHeight="344" d:DesignWidth="394"
             Name="ClockUserControl">

    <!--时钟（Clock）-->
    <Grid Width="300" Height="340">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!--番茄钟状态和周期-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0"
                        Visibility="{Binding StateData.CurrentMode, Converter={StaticResource TimerModeToPomodoroVisibilityConverter}}">
                <TextBlock Text="{Binding TimeData.PomodoroState, Converter={StaticResource PomodoroStateToTextConverter}}"
                           Foreground="{Binding TimeData.PomodoroState, Converter={StaticResource PomodoroStateToColorConverter}}"
                           FontSize="18" FontFamily="{StaticResource MaybeCuteFontFamily}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TimeData.CurrentCycle, Converter={StaticResource PomodoroCycleToTextConverter}}"
                           Foreground="#FF656565" FontSize="14" FontFamily="{StaticResource MaybeCuteFontFamily}"/>
            </StackPanel>

            <Viewbox MaxWidth="280" Margin="0,-5,0,0">
                <TextBlock Name="ClockTextBlock" Text="{Binding ElementName=ClockUserControl,Path=Time.TimeToHourString}"
                           Foreground="#FF656565"
                           FontFamily="{StaticResource MaybeCuteFontFamily}"/>
            </Viewbox>
        </StackPanel>
    </Grid>

</UserControl>
