<!--计时器功能-->
<UserControl x:Class="CatTimer_WpfProject.TimingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatTimer_WpfProject"
             mc:Ignorable="d" 
             d:DesignHeight="344" d:DesignWidth="394"
             Name="TimingUserControl">

    <Grid Width="300" Height="340">

        <!--白底-->
        <Border Background="White" Opacity="1" Height="340"></Border>


        
        <!--背景-->
        <Canvas>
            <Border Background="#ffcd2f" Opacity="1"
                    Height="110" Width="90" Canvas.Left="55" Canvas.Top="105"
                    CornerRadius="10"></Border>
            <Border Background="#e2e2e2" Opacity="1"
                    Height="110" Width="90" Canvas.Left="155" Canvas.Top="105"
                    CornerRadius="10"></Border>

        </Canvas>


        <!--时间-->
        <Canvas>
            <!--冒号-->
            <TextBlock Text=":" 
                       Foreground="#FF656565" FontSize="150" FontFamily="{StaticResource MaybeCuteFontFamily}"
                       Canvas.Top="75" Canvas.Left="140"/>

            <!--分钟-->
            <Border Canvas.Top="90" Canvas.Left="35" Height="120" Width="110">
                <!--剪裁-->
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,110,120"/>
                </Border.Clip>

                <!--分钟-->
                <TextBox Name="MinuteTextBlock" Text="{Binding ElementName=TimingUserControl,Path=Minute}"
                     BorderBrush="Transparent" BorderThickness="0" Background="Transparent" 
                     Foreground="#FF656565" FontSize="150"
                     Padding="0,-10,0,0"
                     TextAlignment="Center"
                     FontFamily="{StaticResource MaybeCuteFontFamily}"
                     MaxLength="2"
                     SelectionBrush ="Gray"
                     
                     InputMethod.IsInputMethodEnabled="False"
                     PreviewTextInput="txt_PreviewTextInput"
                     PreviewKeyDown="txt_PreviewKeyDown"
                     PreviewMouseWheel="txt_OnPreviewMouseWheel"
                         
                     ContextMenu="{x:Null}"/>
            </Border>

            <!--秒数-->
            <Border Canvas.Top="90" Canvas.Right="35" Height="120" Width="110">
                <!--剪裁-->
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,110,120"/>
                </Border.Clip>

                <!--秒数-->
                <TextBox Name="SecondTextBlock" Text="{Binding ElementName=TimingUserControl,Path=Second}"
                     BorderBrush="Transparent" BorderThickness="0" Background="Transparent" 
                     Foreground="#FF656565" FontSize="150"
                     Padding="0,-10,0,0"
                     TextAlignment="Center"
                     FontFamily="{StaticResource MaybeCuteFontFamily}"
                     MaxLength="2"
                     SelectionBrush ="Gray"
                                                  
                     InputMethod.IsInputMethodEnabled="False"
                     PreviewTextInput="txt_PreviewTextInput"
                     PreviewKeyDown="txt_PreviewKeyDown"
                     PreviewMouseWheel="txt_OnPreviewMouseWheel"
                         
                     ContextMenu="{x:Null}"/>
            </Border>

        </Canvas>


        <!--按钮-->
        <Canvas>
            <!--模式切换-->
            <local:CheckBoxControl x:Name="ModeCheckBox"
                                   Canvas.Left="25" Canvas.Top="275"
                                   Width="16" Height="16"
                                   Background="{StaticResource CheckBox.Background.ImageBrush}"
                                   Icon="{StaticResource CheckBox.Foreground.ImageBrush}"
                                   IconWidth="10" IconHeight="10"
                                   Cursor="Hand"
                                   Checked="ModeCheckBox_OnChecked"
                                   Unchecked="ModeCheckBox_OnUnchecked"/>
            <TextBlock x:Name="ModeTextBlock" Text="{DynamicResource Timing.Mode.Forward}" 
                    Foreground="#FF656565" FontSize="16" 
                    FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"
                    Canvas.Left="45" Canvas.Top="273"
                    IsHitTestVisible="False"/>

            <!--分钟按钮-->
            <local:ButtonControl x:Name="MinuteUpButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Up.ImageBrush}"
                                 IconWidth="16" IconHeight="16" Canvas.Top="80" Canvas.Left="87"
                                 Cursor="Hand"
                                 Click="MinuteUpButton_Click"
                                 PreviewMouseLeftButtonDown="MinuteUpButton_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="MinuteUpButton_OnPreviewMouseLeftButtonUp"/>
            <local:ButtonControl x:Name="MinuteDownButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Down.ImageBrush}"
                                 IconWidth="16" IconHeight="16" Canvas.Top="215" Canvas.Left="87"
                                 Cursor="Hand"
                                 Click="MinuteDownButton_Click"
                                 PreviewMouseLeftButtonDown="MinuteDownButton_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="MinuteDownButton_OnPreviewMouseLeftButtonUp"/>

            <!--秒钟按钮-->
            <local:ButtonControl x:Name="SecondUpButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Up.ImageBrush}"
                                 IconWidth="16" IconHeight="16" Canvas.Top="80" Canvas.Left="200"
                                 Cursor="Hand"
                                 Click="SecondUpButton_Click"
                                 PreviewMouseLeftButtonDown="SecondUpButton_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="SecondUpButton_OnPreviewMouseLeftButtonUp"/>
            <local:ButtonControl x:Name="SecondDownButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Down.ImageBrush}"
                                 IconWidth="16" IconHeight="16" Canvas.Top="215" Canvas.Left="200"
                                 Cursor="Hand"
                                 Click="SecondDownButton_Click"
                                 PreviewMouseLeftButtonDown="SecondDownButton_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="SecondDownButton_OnPreviewMouseLeftButtonUp"/>

            <local:ButtonControl x:Name="SrartButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{DynamicResource Timing.Start.ImageBrush}"
                                 IconWidth="70" IconHeight="32" Canvas.Right="25" Canvas.Top="270"
                                 Cursor="Hand"
                                 Click="StartButton_Click"/>

            <local:ButtonControl x:Name="PomodoroButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Width="80" Height="40" Canvas.Left="110" Canvas.Top="260"
                                 IconWidth="80" IconHeight="40"
                                 Cursor="Hand"
                                 Click="PomodoroButton_Click"
                                 Visibility="{Binding SettingData.IsPomodoroEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <local:ButtonControl.Icon>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <TextBlock Text="{Binding SettingData.PomodoroWorkTime, StringFormat='{}{0}min'}" 
                                       Foreground="#FF656565" 
                                       FontSize="24" FontFamily="{StaticResource MaybeCuteFontFamily}" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </local:ButtonControl.Icon>
            </local:ButtonControl>
        </Canvas>

    </Grid>
</UserControl>
