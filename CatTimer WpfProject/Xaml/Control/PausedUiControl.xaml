<!--已暂停界面 的控件-->
<UserControl x:Class="CatTimer_WpfProject.PausedUiControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatTimer_WpfProject"
             mc:Ignorable="d" 
             d:DesignHeight="344" d:DesignWidth="394"
             Name="PausedUiUserControl">

    <Grid>
        <Border Background="#FF898989">

            <Grid Width="300" Height="340">
                <Border Background="{DynamicResource Timer.Paused.ImageBrush}"
                        Width="280" Height="90"
                        Margin="0,-140,0,0"></Border>


                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="140,40,0,0">
                    <!--番茄钟状态和周期-->
                    <Canvas Height="25" Width="140" Margin="0,0,0,0" ClipToBounds="True"
                                Visibility="{Binding StateData.CurrentMode, Converter={StaticResource TimerModeToPomodoroVisibilityConverter}}">
                        <StackPanel Name="ScrollingTextStackPanel" Orientation="Horizontal" Canvas.Left="0">
                            <StackPanel.Resources>
                                <Storyboard x:Key="ScrollAnimation" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="ScrollingTextStackPanel"
                                                     Storyboard.TargetProperty="(Canvas.Left)"
                                                     From="140" To="-300" Duration="0:0:8" />
                                </Storyboard>
                            </StackPanel.Resources>
                            <StackPanel.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource ScrollAnimation}" />
                                </EventTrigger>
                            </StackPanel.Triggers>

                            <TextBlock Text="{Binding TimeData.PomodoroState, Converter={StaticResource PomodoroStateToTextConverter}}"
                               Foreground="{Binding TimeData.PomodoroState, Converter={StaticResource PomodoroStateToColorConverter}}"
                               FontSize="16" FontFamily="{StaticResource MaybeCuteFontFamily}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding TimeData.CurrentCycle, Converter={StaticResource PomodoroCycleToTextConverter}}"
                               Foreground="#FF656565" FontSize="14" FontFamily="{StaticResource MaybeCuteFontFamily}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Canvas>

                    <Viewbox Width="110" Height="80" Margin="0,-5,0,0">
                        <TextBlock Name="ColckTextBlock"
                                   Text="{Binding ElementName=PausedUiUserControl,Path=Clock.TimeToHourString}"
                                   Foreground="#FF656565"
                                   FontFamily="{StaticResource MaybeCuteFontFamily}"/>
                    </Viewbox>
                </StackPanel>

            </Grid>

        </Border>
    </Grid>
</UserControl>
